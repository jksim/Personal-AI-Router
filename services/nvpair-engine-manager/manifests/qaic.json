{
  "engine": "qaic",
  "display_name": "Qualcomm AI 100",
  "manifest_version": 1,
  "actions": {
    "list_models": {
      "description": "List the models whose QPC is in the models directory (<owner>/<name>/<qpc-config>/qpc-*/qpc/programqpc.bin).",
      "cmd": [
        "sh",
        "-c",
        "cd \"{models_dir}\" 2>/dev/null || exit 0; for f in */*/*/qpc-*/qpc/programqpc.bin; do [ -f \"$f\" ] && printf '%s\\n' \"$f\" | cut -d/ -f1-2; done | sort -u"
      ],
      "result": {
        "lines": true
      }
    },
    "loaded_models": {
      "description": "List the model the Qualcomm engine is serving. It serves one model per process.",
      "http": {
        "method": "GET",
        "path": "/v1/models"
      },
      "result": {
        "array": "data",
        "field": "id"
      }
    },
    "chat": {
      "description": "OpenAI-compatible chat completion (params: {\"model\": \"<name>\", \"messages\": [...]}).",
      "http": {
        "method": "POST",
        "path": "/v1/chat/completions",
        "body_schema": {
          "model": "string",
          "messages": "array"
        }
      }
    }
  },
  "platforms": {
    "linux/amd64": {
      "detect": [
        "{install_dir}/qaic-serve"
      ],
      "install": {
        "run": [
          "sh",
          "-c",
          "set -e; docker pull \"$2\"; mkdir -p \"$1/home\" \"$1/hf\"; printf '%s' \"$3\" | base64 -d > \"$1/qaic-serve\"; chmod 755 \"$1/qaic-serve\"",
          "qaic-install",
          "{install_dir}",
          "ghcr.io/quic/cloud_ai_inference_vllm@sha256:55cbcb6a11a50a18613ac41523cfefcf75f7c1e64e5e0c43ff4a3334e33d97a9",
          ""
        ],
        "mode": "user"
      },
      "uninstall": {
        "run": [
          "sh",
          "-c",
          "docker rmi ghcr.io/quic/cloud_ai_inference_vllm@sha256:55cbcb6a11a50a18613ac41523cfefcf75f7c1e64e5e0c43ff4a3334e33d97a9 >/dev/null 2>&1 || true"
        ],
        "remove": [
          "{install_dir}"
        ]
      },
      "runtime": {
        "mode": "process",
        "bin": "{install_dir}/qaic-serve",
        "args": [
          "{model}"
        ],
        "env": {
          "QAIC_HOST": "{host}",
          "QAIC_PORT": "{port}",
          "QAIC_MODELS_DIR": "{models_dir}",
          "QAIC_INSTALL_DIR": "{install_dir}"
        },
        "bind": "127.0.0.1",
        "port": 8101,
        "ready": {
          "http": "http://127.0.0.1:{port}/health",
          "status": 200,
          "timeout_s": 540
        },
        "stop": {
          "signal": "term",
          "grace_s": 60
        },
        "health": {
          "http": "http://127.0.0.1:{port}/health",
          "status": 200,
          "interval_s": 10
        },
        "editable_launch": {
          "fixed_args": [
            "{model}"
          ],
          "controls": [
            {
              "env": [
                "QAIC_PORT"
              ],
              "value": "{server.port}"
            },
            {
              "env": [
                "QAIC_HOST"
              ],
              "value": "{server.host}"
            }
          ]
        }
      },
      "models_dir": "~/.local/share/nvpair/qaic-models"
    }
  }
}
